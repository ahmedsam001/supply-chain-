# Environment Configuration - Copy to .env and fill in values
# DO NOT commit .env to version control

# ── Databricks Lakehouse (Primary Egypt DWH Target) ─────────────────────────
DATABRICKS_HOST=https://your-workspace-id.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_USERNAME=by234DEPI
DATABRICKS_PASSWORD=DEPI@234
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

# ── Daily Midnight Collection Mode ───────────────────────────────────────────
# Set COLLECTION_MODE=live to scrape live Egypt e-commerce catalogs at 00:00
COLLECTION_MODE=live
MAX_PRODUCTS_PER_SOURCE=1000000000000

# ── Optional PostgreSQL Sync ─────────────────────────────────────────────────
PG_URL=postgresql://user:password@localhost:5432/egypt_ecommerce
DATABASE_URL=postgresql://user:password@localhost:5432/egypt_ecommerce
DATABASE_SCHEMA=public

# ── Proxy Configuration (Webshare / Residential Rotating Proxies) ────────────
PROXY_URL=http://user:password@p.webshare.io:80/
HTTP_PROXY=http://user:password@p.webshare.io:80/
HTTPS_PROXY=http://user:password@p.webshare.io:80/

# ── Extraction Settings ──────────────────────────────────────────────────────
DEFAULT_RATE_LIMIT_RPM=30
DEFAULT_MIN_DELAY_SECONDS=1.5
DEFAULT_MAX_DELAY_SECONDS=4.0
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_MAX_RETRIES=3
MAX_CONCURRENT_EXTRACTORS=2

# ── Playwright ───────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=100

# ── Data Directories ─────────────────────────────────────────────────────────
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
BRONZE_DATA_DIR=./data/bronze
SILVER_DATA_DIR=./data/silver
GOLD_DATA_DIR=./data/gold

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
